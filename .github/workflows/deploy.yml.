
name: Deploy Routine to RangelLab Pages

on:
  workflow_dispatch:
  push:
    branches: [main]

permissions:
  contents: read

concurrency:
  group: routine-pages-deploy
  cancel-in-progress: false

jobs:
  build-and-publish:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Routine
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Build Routine
        run: npm run build -- --base=/routine/

      - name: Publish Routine to RangelLab
        env:
          GH_TOKEN: ${{ secrets.JSLYNK_PAGES_TOKEN }}
        run: |
          set -euo pipefail
          test -n "$GH_TOKEN" || {
            echo "Secret JSLYNK_PAGES_TOKEN is missing"
            exit 1
          }

          git clone \
            "https://x-access-token:${GH_TOKEN}@github.com/jeffersonrcs-cmd/RangelLab.git" \
            pages-repo

          mkdir -p pages-repo/routine
          find pages-repo/routine -mindepth 1 -maxdepth 1 \
            -exec rm -rf {} +

          cp -R dist/. pages-repo/routine/

          cd pages-repo
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add routine
          git diff --cached --quiet || {
            git commit -m "Deploy Routine to Pages"
            git push origin HEAD:main
          }
